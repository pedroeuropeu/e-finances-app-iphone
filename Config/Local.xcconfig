// Ambiente local (docker-local + backend neste Mac). O simulador enxerga o "localhost" do Mac direto.
// Num iPhone de verdade, troque localhost pelo IP do Mac na rede (ex.: 192.168.0.10).
#include "Base.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = top.efinances.app.local$(EF_BUNDLE_SUFFIX)
EF_DISPLAY_NAME = e-Finances Local
EF_DEMO = NO
EF_ENV_LABEL = Local
EF_API_BASE_URL = http:/$()/localhost:8080/
EF_TOKEN_URL = http:/$()/localhost:8088/realms/finances-realm/protocol/openid-connect/token
EF_WEB_URL = http:/$()/localhost:4200/
